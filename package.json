{
  "name": "chathub-ai",
  "version": "0.1.0",
  "description": "ChatHub AI multi-channel customer support desktop app",
  "author": {
    "name": "ChatHub AI",
    "email": "noreply@chathub.ai"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "electron:dev": "concurrently -k -s first \"npm:dev\" \"wait-on http://localhost:3000 && electron electron/main.cjs\"",
    "electron:build:mac": "npm run build && electron-builder --mac --publish never",
    "electron:build:win": "npm run build && electron-builder --win --publish never",
    "electron:build:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@xyflow/react": "^12.8.4",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "openai": "^5.20.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.33",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.chathub.ai.desktop",
    "productName": "ChatHub AI",
    "publish": null,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "app/**/*",
      "components/**/*",
      "context/**/*",
      "lib/**/*",
      "prisma/**/*",
      "public/**/*",
      "next.config.mjs",
      "package.json",
      "!**/*.tsbuildinfo"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "ChatHub AI <noreply@chathub.ai>",
      "target": ["AppImage", "deb"]
    }
  }
}
